# PolyGen - Backend Environment Configuration
# Optional: Set external 3D & Texture Cloud API credentials.
# If omitted or running offline, PolyGen automatically uses its built-in
# Semantic Procedural AI 3D engine, xatlas UV unwrapper, and PBR texture synthesizer.

# =====================================================================
# Week 1: Text-to-3D Model Generation APIs
# =====================================================================
# Meshy API (https://meshy.ai)
MESHY_API_KEY=

# Tripo3D API (https://tripo3d.ai)
TRIPO_API_KEY=

# =====================================================================
# Week 2: Texture Generation APIs (Stable Diffusion & ControlNet)
# =====================================================================
# Stability AI API (https://platform.stability.ai) - for SDXL Text-to-Texture
STABILITY_API_KEY=

# Hugging Face Inference API (https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=

# Local WebUI / ComfyUI Endpoint (if running SD WebUI with ControlNet locally)
# Example: http://127.0.0.1:7860
SD_WEBUI_URL=

# Local Diffusers Configuration (if PyTorch + CUDA are installed)
DIFFUSERS_MODEL_ID=runwayml/stable-diffusion-v1-5
CONTROLNET_MODEL_ID=lllyasviel/control_v11f1p_sd15_depth

# =====================================================================
# Server Configuration
# =====================================================================
POLYGEN_HOST=0.0.0.0
POLYGEN_PORT=8000
