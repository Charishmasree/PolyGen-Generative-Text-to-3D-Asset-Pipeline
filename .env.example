# PolyGen - Backend Environment Configuration
# Optional: Set external Text-to-3D Cloud API keys.
# If omitted, PolyGen automatically uses its built-in Procedural & Semantic AI 3D engine.

# Meshy API (https://meshy.ai)
MESHY_API_KEY=

# Tripo3D API (https://tripo3d.ai)
TRIPO_API_KEY=

# Host and Port configuration
POLYGEN_HOST=0.0.0.0
POLYGEN_PORT=8000

